{
  "name": "memora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node --import ./scripts/resolve-ext.mjs scripts/generate-pack-manifest.mjs && node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "node scripts/generate-seo-files.mjs && node --import ./scripts/resolve-ext.mjs scripts/generate-essay-plans.mjs && node --import ./scripts/resolve-ext.mjs scripts/generate-pack-manifest.mjs && node scripts/copy-pyodide.mjs && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "seo:files": "node scripts/generate-seo-files.mjs && node --import ./scripts/resolve-ext.mjs scripts/generate-essay-plans.mjs",
    "og": "python3 scripts/og/generate.py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/opendyslexic": "^5.2.5",
    "@lezer/highlight": "^1.2.5",
    "firebase": "^12.19.0",
    "framer-motion": "^12.42.2",
    "pyodide": "^314.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-tools": "^15.28.2",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1"
  }
}
